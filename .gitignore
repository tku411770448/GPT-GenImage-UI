# Python bytecode cache. The app disables bytecode writing at runtime
# (sys.dont_write_bytecode + PYTHONDONTWRITEBYTECODE), so normal runs do not
# create these; ignored anyway as a safety net.
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# VS Code local settings
.vscode/

# Single shared log file at the repo root (key execution nodes + crash diagnostics).
# Matches log.txt at any depth and any *.log file.
log.txt
*.log

# Local scratch prompt file (developer note, not part of the project)
codex_prompt.txt

# Per-project runtime data: uploaded images, runs/, generated images, exports and
# project_state.json all live under modes/<mode>/project/ (matched at any depth).
**/project/

# Export archives produced by the Export step
*.zip
*.tar
*.tar.gz

# Secrets / API keys (the UI stores the shared key in .env)
.env
*.key

# OS files
.DS_Store
Thumbs.db
desktop.ini
