# Python cache
__pycache__/
*.py[cod]
*.pyo

# Config
config/
configs/

# Virtual environment
.venv/
venv/
env/
*.txt

# VS Code local settings
.vscode/

# Logs (single shared log file log.txt at the repo root + any stray logs folders)
*.log
log.txt
logs/

# Temporary files
tmp/
temp/
.cache/

# Output / generated files
outputs/
output/
runs/
exports/
artifacts/
export/
results/
# Per-mode runtime project data lives under modes/<mode>/project/ (ignored at any depth).
project/
**/project/
# Legacy runtime folder names kept ignored for backward compatibility.
project_defect/
project_food/
**/project_defect/
**/project_food/

# Project-generated images and UI byproducts
project/**/*.png
project/**/*.jpg
project/**/*.jpeg
project/**/*.webp
project/**/*.bmp
project/**/*.tif
project/**/*.tiff
project/**/runs/
project/**/exports/
project/**/logs/

# Images or generated datasets, 視情況調整
*.zip
*.zip
*.tar
*.tar.gz

# Secrets / API keys
.env
*.key
secrets.json
api_key.txt

# OS files
.DS_Store
Thumbs.db
desktop.ini
